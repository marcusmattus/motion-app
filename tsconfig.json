{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "noEmit": true,
    "isolatedModules": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "supabase/edge-functions"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
