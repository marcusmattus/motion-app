# Motion App Environment Variables

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_KEY=your-anon-key

# App Environment
EXPO_PUBLIC_APP_ENV=development

# Gemini API (for nutrition scanning)
EXPO_PUBLIC_GEMINI_KEY=your-gemini-api-key

# Optional: PostHog Analytics
POSTHOG_API_KEY=

# Optional: Firebase
FIREBASE_API_KEY=

# Optional: GCP for advanced ML
GCP_PROJECT_ID=

# Optional: Server-side pose analysis endpoint
CLOUD_POSE_URL=

# Optional: Custom avatar pose model path
AVATAR_POSE_MODEL_PATH=
